{
    "name": "rs2b0t",
    "description": "Scriptable direct-input bot client for rs2b2t",
    "license": "MIT",
    "module": "src/client/shell/Client.ts",
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "gen:nav-transports": "sh tools/nav/derive-transports.sh",
        "build": "bun run bundle.ts",
        "build:dev": "bun run bundle.ts dev",
        "build:bot": "bun run bot.bundle.ts",
        "build:bot:dev": "bun run bot.bundle.ts dev",
        "b0t": "sh tools/b0t.sh",
        "test": "bun test",
        "lint": "eslint .",
        "lint:prose": "node_modules/@vvago/vale/bin/vale docs README.md src/bot tools e2e test bundle.ts bot.bundle.ts eslint.config.ts identifier.js",
        "lint:prose:extras": "bun tools/lint-prose-extras.ts --gate=doc-cap,fragment,why-tag,comment-block",
        "audit:exports": "bun tools/audit-exports.ts",
        "audit:script-dirs": "bun tools/audit-script-dirs.ts",
        "audit:e2e-split": "bun tools/audit-e2e-split.ts --after",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write",
        "smoke": "bun e2e/e2e-smoke.ts",
        "gen:shopdb": "bun tools/shops/gen-shopdb.ts",
        "gen:cluedb": "bun tools/clues/gen-cluedb.ts",
        "gen:dropdb": "bun tools/combat/gen-dropdb.ts",
        "gen:itemdb": "bun tools/items/gen-itemdb.ts",
        "gen:scriptdocs": "bun tools/gen-scriptdocs.ts",
        "verify:gatheringbot": "bun e2e/gatheringbot-test.ts",
        "verify:thievingbot": "bun e2e/thievingbot-test.ts",
        "verify:coaltrucks": "bun e2e/coaltrucks-test.ts",
        "gen:basemap": "bun tools/map/build-basemap.ts",
        "verify:map-picker": "bun e2e/map-picker-basemap-live.ts",
        "verify:map-picker-e2e": "bun e2e/map-picker-walkto-e2e-live.ts",
        "e2e": "bun e2e/runner.ts"
    },
    "dependencies": {
        "fflate": "^0.8.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@happy-dom/global-registrator": "^20.10.6",
        "@types/bun": "1.2.23",
        "@vvago/vale": "3.17.1",
        "eslint": "^9.39.2",
        "globals": "^17.0.0",
        "jiti": "^2.6.1",
        "playwright-core": "^1.60.0",
        "prettier": "^3.7.1",
        "terser": "^5.46.0",
        "typescript-eslint": "^8.53.0"
    },
    "trustedDependencies": ["@vvago/vale"],
    "peerDependencies": {
        "typescript": "^5.0.0"
    }
}
