# rs2bot local environment configuration
# Copy to .env and fill in values from your local engine/client.js

# Engine directory (where the lostcity engine is built)
# Default: ../Server/engine (relative to rs2b0t/)
ENGINE_DIR=../Server/engine

# Content directory (where the lostcity content/data is)
# Default: ../Server/content (relative to rs2b0t/)
CONTENT_DIR=../Server/content

# RSA keys extracted from your local engine's client.js
# Extract from: ENGINE_DIR/public/client/client.js
# Search for: the 256+ digit modulus in the minified bundle
# RSAE = public exponent (always 65537), RSAN = modulus

# Local engine (lostcity) RSA keys
LOCAL_RSAE=65537
LOCAL_RSAN=your_local_modulus_here

# Live server RSA (2004scape production)
LIVE_RSAN=your_live_modulus_here

# Production RSA (rs2b2t production)
PROD_RSAN=your_prod_modulus_here

# Secure origin for bot client (where bot.html is served from)
# e.g., https://your-server.com
SECURE_ORIGIN=https://localhost

# Login RSA keys (from client.js - same as LOCAL for local dev)
LOGIN_RSAE=65537
LOGIN_RSAN=your_local_modulus_here

# Secure origin for main client
LOGIN_SECURE_ORIGIN=https://localhost